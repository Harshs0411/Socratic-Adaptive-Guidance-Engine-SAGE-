# OpenAI API Key for LangGraph multi-agent LLMs and ChromaDB embeddings
OPENAI_API_KEY=your_openai_api_key_here

# Database Connection URL (Supports SQLite locally or PostgreSQL on Render)
# Local Development: leave blank or use SQLite (Zero setup, no Docker required):
# DATABASE_URL=sqlite+aiosqlite:///multi_agent_tutor/data/sage_sessions.db
# Production (Render): Set this to your Render PostgreSQL database connection string:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sage_db

# ChromaDB persistence directory (defaults to multi_agent_tutor/data/chroma_db)
CHROMA_PERSIST_DIRECTORY=multi_agent_tutor/data/chroma_db
