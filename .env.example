# OpenAI API Key for LangGraph multi-agent LLMs and ChromaDB embeddings
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Database Connection URL (Asyncpg)
# Default for Docker Compose: postgresql+asyncpg://postgres:postgres@localhost:5432/sage_db
# (If omitted or unreachable, SAGE automatically falls back to local persistent SQLite)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sage_db

# ChromaDB persistence directory (defaults to multi_agent_tutor/data/chroma_db)
CHROMA_PERSIST_DIRECTORY=multi_agent_tutor/data/chroma_db
